# Copy to .env (gitignored) or set these in Dokploy's Environment settings.

# Required: upstream Ethereum JSON-RPC endpoint.
ERC4337_BUNDLER_ETH_CLIENT_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID

# Required: bundler EOA private key. May be supplied with or without a leading 0x.
ERC4337_BUNDLER_PRIVATE_KEY=YOUR_BARE_HEX_KEY

# Optional: image build tag.
BUNDLER_VERSION=dev

# Optional overrides (defaults shown / see docs/CONFIGURATION.md):
# ERC4337_BUNDLER_SUPPORTED_ENTRY_POINTS=0x433709009B8330FDa32311DF1C2AFA402eD8D009
# ERC4337_BUNDLER_IS_OP_STACK_NETWORK=true
# ERC4337_BUNDLER_IS_ARB_STACK_NETWORK=true

# Optional: pluggable storage. By default the mempool and reputation data live
# in a node-local BadgerDB under ERC4337_BUNDLER_DATA_DIRECTORY. To share state
# across replicas, point the bundler at Redis/Valkey (see docs/STORAGE.md).
# ERC4337_BUNDLER_STORE_BACKEND=redis
# ERC4337_BUNDLER_STORE_URL=rediss://:REDIS_PASSWORD@redis.example.com:6379/0
# ERC4337_BUNDLER_STORE_NAMESPACE=qubenode
# ERC4337_BUNDLER_STORE_OP_TTL_SECONDS=180
