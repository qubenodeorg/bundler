{
  "name": "qubenode-bundler-e2e",
  "version": "0.0.0",
  "private": true,
  "description": "End-to-end tests for the qubenode-bundler ERC-4337 v0.9 implementation.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:ethereum": "vitest run test/ethereum.test.ts",
    "test:arbitrum": "vitest run test/arbitrum.test.ts",
    "fetch-artifacts": "node --no-warnings=ExperimentalWarning --loader ts-node/esm src/fetch-artifacts.ts",
    "deploy-entrypoint": "node --no-warnings=ExperimentalWarning --loader ts-node/esm src/deploy-entrypoint.ts"
  },
  "dependencies": {
    "ethers": "^6.13.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
